# Copy to .env and adjust. The .env file itself is never committed.
#
#   cp .env.example .env
#
# The values below work as-is for local development.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Local development key only. Generate a fresh one for anything else:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-not-for-production-change-me

# The code defaults to False. It is enabled here for local development,
# so the container shows tracebacks instead of a bare 500 page.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce

# Host and port as seen from *outside* the stack — running manage.py in the
# local virtualenv against the port the db container publishes.
# Inside the stack, compose overrides these with db:5432 for the web service,
# so the same .env works in both cases.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
